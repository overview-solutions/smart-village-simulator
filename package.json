{
  "name": "smart-village-simulator",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Village energy simulator. Consumes @circaevum/locus for place/time graphics primitives.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/prefer-local-locus.mjs",
    "postinstall": "node scripts/prefer-local-locus.mjs",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "geojson": "node scripts/write-village-geojson.js",
    "villages:sync-demo": "node scripts/sync-demo-lv-pack.mjs",
    "villages:sync": "node scripts/sync-villages.mjs",
    "map:prepare": "node scripts/prepare-maps.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@circaevum/locus": "github:Circaevum/locus",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/overview-solutions/smart-village-simulator"
  }
}
