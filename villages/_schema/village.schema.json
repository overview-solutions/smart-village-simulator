{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isv.wiki/schemas/village-pack-v0.json",
  "title": "ISV village pack meta",
  "type": "object",
  "required": ["id", "name", "origin", "crs", "schemaVersion"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "name": { "type": "string" },
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "crs": { "type": "string", "const": "EPSG:4326" },
    "origin": {
      "type": "object",
      "required": ["lon", "lat"],
      "properties": {
        "lon": { "type": "number" },
        "lat": { "type": "number" },
        "alt": { "type": "number", "default": 0 },
        "note": { "type": "string" }
      }
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" },
      "description": "[west, south, east, north] WGS84 — LOD 0"
    },
    "status": {
      "type": "string",
      "enum": ["hypothetical", "survey", "as-built", "unverified"]
    },
    "openami": {
      "type": "object",
      "properties": {
        "spatialSchema": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
